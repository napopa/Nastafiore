{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "google": {
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "local"
    },
    "production": {
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {}
  }
}
